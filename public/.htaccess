# Riffi – Apache config for the app folder only. Does not affect WordPress.

Options -Indexes
DirectoryIndex index.html

<IfModule mod_mime.c>
  AddType application/wasm .wasm
  AddType application/manifest+json .webmanifest
  AddType application/json .json
  AddType application/octet-stream .bin
  AddType font/woff2 .woff2
  AddType text/javascript .js .mjs
</IfModule>

# HTTPS is mandatory: browsers block the microphone and camera otherwise.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Never rewrite the API.
  RewriteRule ^api/ - [L]

  # SPA fallback: anything that isn't a real file or folder goes to index.html.
  # The flag lets us send no-cache headers on these routes too (see below).
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . index.html [L,E=RIFFI_HTML:1]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "same-origin"
  Header always set Permissions-Policy "microphone=(self), camera=(self), geolocation=()"
  Header always set Strict-Transport-Security "max-age=31536000"

  # Caching (works with Cloudflare in front, which honours these headers).
  #
  # 1. Vite's hashed build files never change: cache for a year.
  <FilesMatch "-[A-Za-z0-9_-]{8}\.(js|css|woff2|wasm)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # 2. Other static files (icons, icon font, piano model) keep their names
  #    between releases: cache briefly, then check back.
  <FilesMatch "\.(png|svg|ico|woff2|bin|json|txt)$">
    Header set Cache-Control "public, max-age=3600, must-revalidate"
  </FilesMatch>

  # 3. The app shell must never go stale after a deploy: index.html, the
  #    service worker, its registration script and the web manifest are always
  #    re-checked with the server (by browsers and by Cloudflare).
  <FilesMatch "^(index\.html|sw\.js|registerSW\.js|manifest\.webmanifest)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate, max-age=0"
    Header set CDN-Cache-Control "no-store"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>
  # SPA routes (/home, /practice/…) are index.html served by the rewrite above.
  Header set Cache-Control "no-cache, no-store, must-revalidate, max-age=0" env=REDIRECT_RIFFI_HTML
  Header set CDN-Cache-Control "no-store" env=REDIRECT_RIFFI_HTML
  # The bare folder URL ("/") is index.html via DirectoryIndex, so rule 3 covers it too.
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/json application/manifest+json image/svg+xml
</IfModule>
