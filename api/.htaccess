# Riffi API folder: only omr.php is reachable from the web.

Options -Indexes

<IfModule mod_authz_core.c>
  Require all denied
  <Files "omr.php">
    Require all granted
  </Files>
</IfModule>
<IfModule !mod_authz_core.c>
  Order deny,allow
  Deny from all
  <Files "omr.php">
    Allow from all
  </Files>
</IfModule>

# Upload limits for photos (only applies where PHP runs as an Apache module;
# on PHP-FPM hosts set these in .user.ini or the control panel instead).
<IfModule mod_php.c>
  php_value upload_max_filesize 4M
  php_value post_max_size 34M
  php_value max_file_uploads 10
  php_value max_execution_time 600
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Cache-Control "no-store"
</IfModule>
