{
  "name": "riffi",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "php:lint": "find api -name '*.php' -print0 | xargs -0 -n1 php -l",
    "copy-model": "node scripts/copy-model.mjs",
    "postinstall": "node scripts/copy-model.mjs"
  },
  "dependencies": {
    "@spotify/basic-pitch": "1.0.1",
    "@tensorflow/tfjs": "4.22.0",
    "dexie": "4.0.11",
    "dexie-react-hooks": "1.1.7",
    "opensheetmusicdisplay": "1.9.0",
    "pitchy": "4.1.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@playwright/test": "1.56.1",
    "@types/node": "22.15.0",
    "@types/react": "18.3.23",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "eslint": "9.39.1",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-react-refresh": "0.4.20",
    "fake-indexeddb": "6.0.1",
    "globals": "16.2.0",
    "jsdom": "26.1.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.0",
    "vite": "6.4.1",
    "vite-plugin-pwa": "1.1.0",
    "vitest": "3.2.4"
  },
  "overrides": {
    "@spotify/basic-pitch": {
      "@tensorflow/tfjs": "$@tensorflow/tfjs"
    }
  }
}
